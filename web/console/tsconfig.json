{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": false, "skipLibCheck": true, "isolatedModules": true, "noEmit": true,
    "baseUrl": ".", "paths": { "@/*": ["./src/*"], "next/link": ["./src/lib/shims/next-link.tsx"] }, "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
