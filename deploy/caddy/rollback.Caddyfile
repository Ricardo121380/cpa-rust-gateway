# P12-09 rollback target: send every request on the production hostname back to the incumbent CPA.
#
# This is the preimage the runbook restores. It is byte-identical in effect to the site block that
# existed before the Canary split, so `caddy reload` with this file removes the new gateway from the
# request path entirely without touching DNS, TLS, or any other site.
#
# Rolling back is a file swap plus one reload; P12-09 measures how long that reload takes to take
# effect and records it as the RTO evidence.

cpa.example.invalid {
	reverse_proxy 127.0.0.1:8317
}
