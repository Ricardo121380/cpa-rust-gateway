# Oracle Singapore ARM64 runtime for the migrated Autoreg project.
# The source project pins the Google Chrome apt repository to amd64.  Oracle's
# aarch64 host instead uses Playwright/CloakBrowser's ARM-compatible Chromium
# distribution; all application code and Python dependency pins remain sourced
# from the migrated project tree.
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    xauth \
    x11-utils \
    wget \
    ca-certificates \
    fonts-noto-cjk \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libc6 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY requirements.txt /tmp/requirements.txt
COPY apps/console/requirements.txt /tmp/console-requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && pip install --no-cache-dir -r /tmp/console-requirements.txt \
    && pip install --no-cache-dir "playwright>=1.55" "cloakbrowser>=0.3.0" "PySocks>=1.7.1" \
    && playwright install --with-deps chromium \
    && python -c "import cloakbrowser; print(cloakbrowser.ensure_binary())"

CMD ["bash"]
